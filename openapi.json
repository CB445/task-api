{
    "openapi": "3.0.0",
    "info": {
        "title": "Task API",
        "version": "1.0.0",
        "description": "A CRUD API for managing an in-memory task list."
    },
    "servers":[
        {
            "url": "http://localhost:3000"
        }
    ],
    "paths":{
        "/tasks": {
             "get": {
                "summary": "List all the tasks",
                "responses": {
                    "200": {
                        "description": "Returns every task in the in-memory task list",
                        "content":{
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "id": {
                                                "type": "integer"
                                            },
                                            "title":{
                                                "type": "string"
                                            },
                                            "done": {
                                                "type": "boolean"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
             },
            "post": {
  "summary": "Create a new task",
  "description": "Creates a task with a title and sets done to false.",
  "requestBody": {
    "required": true,
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": {
              "type": "string",
              "example": "Buy milk"
            }
          }
        }
      }
    }
  },
  "responses": {
    "201": {
      "description": "Task created successfully"
    },
    "400": {
      "description": "Title is missing or empty"
    }
  }
}

        },
        "/tasks/{id}":{
            "parameters":[
                {
                    "name": "id",
                    "in": "path",
                    "required": true,
                    "description": "The ID of the task",
                    "schema":{
                        "type": "integer"
                    }
                }
            ],
            "get":{
                "summary": "Get a task by ID",
                "responses":{
                    "200": {
                        "description": "Returns the matching task"
                    },
                    "404": {
                        "description": "Task not found"
                    }
                }
            },
            "put": {
                "summary": "Update a task by ID",
                "description": "Updates the title, done status, or both.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Buy groceries"
                                    },
                                    "done": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Task updated successfully"
                    },
                    "400": {
                        "description": "Invalid or empty update"
                    },
                    "404": {
                        "description": "Task not found"
                    }
                }
            }
                
        }
    }
}

